<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="hireSystem.service.mapper.BoardImageMapper">
	
	<!-- 업로드 이미지정보 임시저장 -->
	<insert id="insertTempImgInfo" parameterType="map">
		INSERT INTO BOARD_IMAGE
			(
				  BOARD_NUM
				, FILE_NAME
				, FILE_PATH
				, STATUS
				, REG_DT
			) VALUES
			(
				NULL
				, #{fileName}
				, #{filePath}
				, #{status}
				, NOW()
			)
	</insert>

	<!-- 임시저장된 이미지정보 update (boardnum추가) -->
	<update id="updateBoardNumAndStatus">
		UPDATE BOARD_IMAGE SET
			  BOARD_NUM = #{boardNum}
			, STATUS = 'STORE'
		WHERE FILE_NAME IN
		<foreach collection="filenames" item="filename" open="("
			separator="," close=")">
			#{filename}
		</foreach>
	</update>
	
	<!-- DB에 있는 파일들 조회 -->
	<select id="selectFilenamesByBoardNum" parameterType="int" resultType="String">
		SELECT 
			FILE_NAME
		FROM BOARD_IMAGE
		WHERE 
			BOARD_NUM = #{boardNum}
	</select>
	
	<!-- 파일 전체삭제 -->
	<delete id="deleteByBoardNum" parameterType="int">
		DELETE FROM BOARD_IMAGE
		WHERE
			BOARD_NUM = #{boardNum}
	</delete>
	
	<!-- 파일 하나씩 삭제 -->
	<delete id="deleteByFilename" parameterType="String">
		DELETE FROM BOARD_IMAGE
		WHERE
			FILE_NAME = #{fileName}
	</delete>
	
</mapper>