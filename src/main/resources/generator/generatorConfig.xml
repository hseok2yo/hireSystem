<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>

    <!-- ⭐ context는 반드시 필요 -->
    <context id="MySQLTables" targetRuntime="MyBatis3">

        <!-- 주석 -->
        <commentGenerator>
            <property name="suppressAllComments" value="false"/> <!-- 주석 생성 허용 -->
    		<property name="suppressDate" value="true"/>        <!-- 날짜 제거 -->
            <property name="addRemarkComments" value="true"/> <!-- ⭐ DB COMMENT를 VO 주석으로 -->
        </commentGenerator>

        <!-- DB 연결 -->
        <jdbcConnection
            driverClass="com.mysql.cj.jdbc.Driver"
            connectionURL="jdbc:mysql://localhost:3306/hiresystem"
            userId="root"
            password="1234"/>

        <!-- VO -->
        <javaModelGenerator
            targetPackage="hireSystem.vo"
            targetProject="src/main/java"/>

        <!-- Mapper XML -->
<!--         <sqlMapGenerator -->
<!--             targetPackage="egovframework/sqlmap/mysql/hireSystem" -->
<!--             targetProject="src/main/resources"/> -->


        <!-- 테이블 enablecountbyexample 넣으면 HireUserVOExample.java 생성 안 됨-->
        <table tableName="hire_user" domainObjectName="HireUserVO"
         enableCountByExample="false" 
       enableUpdateByExample="false"
       enableDeleteByExample="false"
       enableSelectByExample="false"/>

    </context>

</generatorConfiguration>
